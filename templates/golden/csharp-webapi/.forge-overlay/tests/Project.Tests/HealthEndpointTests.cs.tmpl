using Microsoft.AspNetCore.Mvc;
using Xunit;

/// <summary>
/// Verifies the health endpoint wiring consumed by frontends.
/// </summary>
public sealed class HealthEndpointTests
{
    /// <summary>
    /// Ensures the health controller reports an ok status.
    /// </summary>
    [Fact]
    public void HealthEndpointReportsOk()
    {
        var controller = new {{.CSharpNamespace}}.Controllers.HealthController();

        var result = Assert.IsType<OkObjectResult>(controller.Get());
        var payload = Assert.IsType<{{.CSharpNamespace}}.Controllers.HealthStatus>(result.Value);
        Assert.Equal("ok", payload.Status);
    }
}
