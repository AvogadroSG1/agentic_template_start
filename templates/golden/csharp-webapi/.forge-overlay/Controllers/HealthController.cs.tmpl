namespace {{.CSharpNamespace}}.Controllers
{
    using Microsoft.AspNetCore.Mvc;

    /// <summary>
    /// Serves the liveness contract consumed by frontends and probes.
    /// </summary>
    [ApiController]
    [Route("health")]
    public sealed class HealthController : ControllerBase
    {
        /// <summary>
        /// Reports that the API is up.
        /// </summary>
        /// <returns>The health payload.</returns>
        [HttpGet]
        public IActionResult Get()
        {
            return this.Ok(new HealthStatus("ok"));
        }
    }

    /// <summary>
    /// The health payload contract.
    /// </summary>
    /// <param name="Status">The reported status value.</param>
    public sealed record HealthStatus(string Status);
}
