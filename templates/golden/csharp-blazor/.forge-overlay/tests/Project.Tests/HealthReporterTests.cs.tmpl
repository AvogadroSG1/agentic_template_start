using Xunit;
using {{.CSharpNamespace}};

/// <summary>
/// Verifies the health wiring shared by the endpoint and the home page.
/// </summary>
public sealed class HealthReporterTests
{
    /// <summary>
    /// Ensures the reporter walks with an ok status.
    /// </summary>
    [Fact]
    public void HealthReporterReportsOk()
    {
        IHealthReporter reporter = new HealthReporter();

        Assert.Equal("ok", reporter.Current().Status);
    }
}
